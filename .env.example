# =========================================================================
# Omnibus API — Variáveis de Ambiente
# =========================================================================
# Copie este arquivo para ".env" e ajuste os valores conforme necessário.
# O arquivo ".env" nunca deve ser commitado (já está no .gitignore).
# Em desenvolvimento local, todas as variáveis abaixo já possuem valores
# padrão definidos em application-dev.yml / docker-compose.yml — você só
# precisa deste arquivo se quiser sobrescrever algum valor específico.
# =========================================================================

# --- Aplicação ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Banco de Dados (usado pela aplicação Spring Boot) ---
DB_URL=jdbc:postgresql://localhost:5432/omnibus
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Banco de Dados (usado pelo docker-compose.yml) ---
DB_PORT=5432
DB_NAME=omnibus